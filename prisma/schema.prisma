generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  password      String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  reviews       Review[]
  savedColleges SavedCollege[]
  questions     Question[]
  answers       Answer[]
}

model College {
  id              String         @id @default(cuid())
  name            String
  location        String
  description     String
  fees            Float
  rating          Float
  image           String
  avgPackage      String
  highestPackage  String
  establishedYear Int
  courses         Course[]
  reviews         Review[]
  savedBy         SavedCollege[]
}

model Course {
  id         String  @id @default(cuid())
  collegeId  String
  courseName String
  duration   String
  fees       Float
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Review {
  id         String  @id @default(cuid())
  userId     String
  collegeId  String
  rating     Float
  reviewText String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model SavedCollege {
  id        String  @id @default(cuid())
  userId    String
  collegeId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model Question {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  authorId   String
  questionId String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
